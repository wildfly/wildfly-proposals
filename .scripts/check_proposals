ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)
require 'bundler/setup'
require 'fileutils'
require 'pathname'
require 'yaml'

class FrontMatterExtractor
  def process lines
    return {} if lines.empty?

    front_matter = []
    if lines.first.chomp == '---'
      original_lines = lines.dup
      lines.shift
      while !lines.empty? && lines.first.chomp != '---'
        front_matter << lines.shift
      end

      return YAML.load(front_matter.join("\n"))
    end
    raise "The YAML front matter is not present"
  end
end

class MetadataChecker
  def initialize
    @categories = load_all_categories()
    @stability_levels = ["experimental", "preview", "community", "default"]
  end

  def check pr_number, front_matter, apply_labels
    STDERR.puts "Check front matter #{front_matter}"
    errors = []
    to_add = []
    to_remove = []
    categories_errors = check_categories(pr_number, front_matter)
    if categories_errors.length() > 0
      errors << categories_errors
      to_add << "invalid-categories"
    else
      to_remove << "invalid-categories"
    end
    issue_errors = check_issue(pr_number, front_matter)
    if issue_errors.length() > 0
      errors << issue_errors
      to_add << "missing-issue"
    else
      to_remove << "missing-issue"
    end
    begin
      stability_level, err = check_stability_level(pr_number, front_matter)
      to_remove << "invalid-stability-level"
      # remove any previous stability-levels
      @stability_levels.each do | level |
        to_remove << "stability-level/#{level}" unless level == stability_level
      end
      to_add << "stability-level/#{stability_level}"
    rescue => error
      errors << error.message
      to_add << "invalid-stability-level"
      @stability_levels.each { | level | to_remove << "stability-level/#{level}" }
    end

    if apply_labels
      # Read the labels once and only add or remove what actually needs to
      # change, so that unchanged labels are not removed and re-added on every run.
      labels = current_labels(pr_number)
      to_remove.each { | label | remove_label(pr_number, labels, label) }
      to_add.each { | label | add_label(pr_number, labels, label) }
    end

    relationship_errors = check_relationships(front_matter)
    if relationship_errors.length() > 0
      errors << relationship_errors
    end

    errors
  end

  def current_labels pr_number
    output = `gh pr view #{pr_number} --json labels --jq '.labels[].name'`
    output.split("\n").map(&:strip).reject(&:empty?)
  end

  def add_label pr_number, labels, label
    return if labels.include? label
    system("gh pr edit #{pr_number} --add-label #{label}")
    labels << label
  end

  def remove_label pr_number, labels, label
    return unless labels.include? label
    system("gh pr edit #{pr_number} --remove-label #{label}")
    labels.delete label
  end

  def check_categories pr_number, front_matter
    errors = []
    unless (front_matter.key? "categories") && (front_matter["categories"] != nil) && (front_matter["categories"].length() > 0)
      errors << "Missing field: categories"
    else
      front_matter["categories"].each do | cat_id |
        if @categories.find { | global_cat | cat_id == global_cat["id"] } == nil
          errors << "New category #{cat_id} must be added to _data/wildfly-categories.yaml"
        end
      end
    end
    errors
  end

  def check_issue pr_number, front_matter
    errors = []
    unless (front_matter.key? "issue") && (front_matter["issue"] != nil)
      errors << "Missing field: issue"
    end
    errors
  end

  def check_stability_level pr_number, front_matter
    unless (front_matter.key? "stability-level") && (@stability_levels.include? front_matter["stability-level"])
      raise "Invalid field: stability-level"
    else
      return front_matter["stability-level"]
    end
  end

  def check_relationships front_matter
    errors = []
    relationships = {
      "promotes" => "promoted-by",
      "promoted-by" => "promotes",
      "follows-up-on" => "followed-up-by",
      "followed-up-by" => "follows-up-on"
    }

    relationships.each do |relationship, reciprocal|
      proposals = front_matter[relationship]
      next if proposals == nil

      unless proposals.is_a?(Array)
        errors << "#{relationship} must be a YAML list of repository-relative proposal paths"
        next
      end

      proposals.each do |proposal|
        unless valid_proposal_path?(proposal)
          errors << "#{relationship} contains invalid proposal path: #{proposal.inspect}"
          next
        end

        target_path = File.exist?("pr-proposals/#{proposal}") ? "pr-proposals/#{proposal}" : proposal
        unless File.exist?(target_path)
          errors << "#{relationship} references a proposal that does not exist: #{proposal}"
          next
        end

        target_front_matter = FrontMatterExtractor.new.process(File.readlines(target_path))
        reciprocal_proposals = target_front_matter[reciprocal]
        unless reciprocal_proposals.is_a?(Array) && reciprocal_proposals.include?(current_file_path)
          errors << "#{relationship} reference #{proposal} must be reciprocated by #{reciprocal}: #{current_file_path}"
        end
      end
    end

    errors
  end

  def valid_proposal_path? proposal
    return false unless proposal.is_a?(String) && proposal.end_with?(".adoc")
    return false if proposal.start_with?("/", "./", "../")

    Pathname.new(proposal).cleanpath.to_s == proposal
  end

  def current_file_path
    @current_file_path
  end

  def current_file_path= file
    @current_file_path = file.sub(%r{\A(\./)?pr-proposals/}, "").sub(%r{\A\./}, "")
  end

  def load_all_categories
    # Prefer the categories file from the pull request when it modifies it.
    categories_path = "pr-proposals/_data/wildfly-categories.yaml"
    categories_path = "_data/wildfly-categories.yaml" unless File.exist?(categories_path)
    yaml = YAML.load_file(categories_path)
    return yaml["categories"]
  end
end

front_matter_extractor = FrontMatterExtractor.new
metadata_checker = MetadataChecker.new

check_succeeds = true

pr_number = ARGV[0]
ARGV.shift

puts "Checking PR #{pr_number}"

# Every changed file is validated, but the labels of the pull request are only
# derived from the proposals it adds, when it adds any. Promoting a feature adds
# a new proposal and also edits the promoted proposal to add 'promoted-by', and
# the labels must reflect the new proposal rather than the last file checked.
new_files = (ENV['NEW_PROPOSAL_FILES'] || '').split("\n").map(&:strip).reject(&:empty?)
label_files = new_files.empty? ? ARGV : new_files
puts "Deriving labels from: #{label_files.join(' ')}"

# Read and print the content of each file passed as arguments
ARGV.each do |file|

  begin
    content = File.read(file)
    front_matter = front_matter_extractor.process content.split("\n")
    metadata_checker.current_file_path = file
    errors = metadata_checker.check pr_number, front_matter, label_files.include?(file)
    if errors.length() > 0
      check_succeeds = false
      puts "❌ #{file}"
      puts "\tFront matter is not valid: #{front_matter}"
      puts "\tGot errors:"
      errors.each do |err|
        puts "\t* #{err}"
      end
    else
      puts "✅ #{file}"
    end
  rescue => e
    check_succeeds = false
    puts "Error reading file #{file}: #{e.message}"
  end
end

exit check_succeeds
